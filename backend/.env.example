# ===========================================
# FOIA OS — Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git.

# Server
PORT=4001
NODE_ENV=production
APP_URL=http://localhost:4001

# Supabase
SUPABASE_URL=https://otpwggeqcjxlvdbcszgj.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT -- generate a real random value (e.g. `openssl rand -hex 32`), never
# copy this placeholder verbatim into a real .env
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE

# SMTP / Email (if used)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@foiaos.com

# CORS — comma-separated origins
CORS_ORIGIN=https://frontend-five-nu-wgj97r88rl.vercel.app,http://localhost:5173

# Storage
STORAGE_SIGNED_URL_EXPIRY=3600

# Google Drive integration (OAuth client — see Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_DRIVE_ROOT_FOLDER=

# Encryption key for SMTP/IMAP passwords stored in email_accounts
ENCRYPTION_KEY=

# Secret checked against the Authorization header on Vercel Cron requests
# (GET /api/cron/imap-poll) — set the same value in Vercel's Cron config / env vars.
CRON_SECRET=
