# ===========================================
# FOIA OS — Backend Environment Variables
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to git.

# Server
PORT=4001
NODE_ENV=production
APP_URL=http://localhost:4001

# Supabase
SUPABASE_URL=https://otpwggeqcjxlvdbcszgj.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# JWT
JWT_SECRET=foia-os-secret-key-change-in-production

# SMTP / Email (if used)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@foiaos.com

# CORS — comma-separated origins
CORS_ORIGIN=https://frontend-five-nu-wgj97r88rl.vercel.app,http://localhost:5173

# Storage
STORAGE_SIGNED_URL_EXPIRY=3600
